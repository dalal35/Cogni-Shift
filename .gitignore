# Python environments, build products and disposable caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local credentials, editor state and operating-system files
.env
.env.*
.DS_Store
.idea/
.vscode/

# Restricted filenames stay private even if moved outside data/.
poe.csv
emar.csv
human_decision_fatigue_dataset.csv
decision_fatigue_dataset.csv

# Restricted local inputs; publish the schema, never clinical extracts.
# Synthetic examples live in cognishift/synthetic.py and remain publishable.
/[dD]ata/*
!/[dD]ata/README.md
# Verified CC0 synthetic behavioral data; provenance is in data/README.md.
!/data/decision_fatigue_dataset.csv

# Every run is local. Curated aggregate evidence lives in docs/results/.
/outputs/

# Private recoverability snapshot of superseded work; never publish.
/.local-archive/
/.public-release/
*.bundle
*.zip
*.tar
*.tar.gz
*.tgz
